# Comma-separated list of allowed CORS origins (no trailing slashes)
# Local dev:   http://localhost:3000,http://localhost:5173
# Production:  https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Port the server listens on (Render/Railway inject this automatically)
PORT=8000

# runtime / debug
ENVIRONMENT=development
LOG_LEVEL=INFO

# LIME tuning — lower = faster but less accurate explanations
LIME_NUM_SAMPLES=300
LIME_NUM_FEATURES=12
